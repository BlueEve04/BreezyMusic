<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Super Lyric API 库声明 minSdk 26，但其代码只用到 Binder/AIDL（API 1 起可用）。
        为保持 BreezyMusic 对 Android 7.0（API 24）的支持，这里显式覆盖库的 minSdk，
        运行时由 LyricPublisher 依据 Build.VERSION.SDK_INT >= 26 做守卫。
    -->
    <uses-sdk tools:overrideLibrary="com.hchen.superlyricapi" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务（媒体播放） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 存储权限（扫描音乐文件） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 运动音乐：读取计步/步频（Android 10+ 需要运行时授权） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 播放音效：查询当前音频输出设备类型（用于按设备记忆音效档位） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="BreezyMusic"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BreezyMusic"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BreezyMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
